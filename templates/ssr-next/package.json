{
  "name": "ssr-next",
  "scripts": {
    "build": "bun run gen && tsc && next build",
    "build-storybook": "storybook build",
    "check": "prettier --write . && eslint . --fix",
    "dev": "next dev --port 3000",
    "doctor": "react-doctor --yes --no-telemetry",
    "format": "prettier --check .",
    "gen": "bun run gen:api && bun run gen:i18n",
    "gen:api": "openapi-ts",
    "gen:i18n": "i18next-cli extract && i18next-cli types",
    "gen:i18n:watch": "i18next-cli extract --watch & i18next-cli types --watch & wait",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "i18n:sync": "i18next-cli sync",
    "init": "bun scripts/init.ts",
    "lint": "eslint .",
    "msw:init": "msw init ./public --save",
    "start": "next start --port 3000",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "ui:add": "bunx --bun shadcn@latest add",
    "verify": "bun run format && bun run lint && bun run typecheck && bun run doctor && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-form": "1.33.4",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "es-toolkit": "1.50.0",
    "i18next": "26.3.6",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.5.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/nextjs-vite": "10.5.7",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "eslint-plugin-storybook": "10.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.9.0",
    "i18next-cli": "1.67.9",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-doctor": "0.9.11",
    "storybook": "10.5.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
