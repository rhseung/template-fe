// Astro 라우터가 이 폴더를 라우트로 취급하지 않게 하는 관례(파일이 .astro가 아니라서).
import { TodosIsland } from '@/pages/_islands/todos-island';
import Layout from '@/layouts/base-layout.astro';
---

<Layout title="ssg — todos">
