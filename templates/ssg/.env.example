# 런타임 API 오리진. 비워두면 상대경로(/api)로 나가고 MSW가 받는다.
# Astro는 `PUBLIC_` 접두사가 붙은 것만 클라이언트 번들에 노출한다 — `VITE_`가 아니다.
PUBLIC_API_BASE_URL=

# Mock Service Worker. 실제 백엔드를 붙이면 false로.
PUBLIC_ENABLE_MSW=true

# OpenAPI 코드젠 입력. 비우면 저장소에 들어있는 ./openapi/example.json 을 쓴다.
# 오프라인에서도 설치·생성이 되는 이유다.
# OPENAPI_INPUT=https://api.example.com/openapi.json

# 1로 두면 dev에서 React Query devtools 오버레이가 뜬다.
PUBLIC_DEVTOOLS=
