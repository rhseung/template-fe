{
  "openapi": "3.1.0",
  "info": {
    "title": "Example API",
    "version": "1.0.0",
    "description": "Vendored so `bun run gen:api` works offline and can never break because someone else's demo server changed. Replace with OPENAPI_INPUT in .env."
  },
  "servers": [{ "url": "/api" }],
  "paths": {
    "/todos": {
      "get": {
        "operationId": "getTodos",
        "summary": "List todos",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTodo",
        "summary": "Create a todo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateTodo" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Todo" } }
            }
          }
        }
      }
    },
    "/todos/{id}": {
      "patch": {
        "operationId": "updateTodo",
        "summary": "Update a todo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTodo" } }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Todo" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Todo": {
        "type": "object",
        "required": ["id", "title", "done", "createdAt"],
        "properties": {
          "id": { "type": "integer", "format": "int32" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "done": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateTodo": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      },
      "UpdateTodo": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "done": { "type": "boolean" }
        }
      }
    }
  }
}
