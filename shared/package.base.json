{
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "msw": {
    "workerDirectory": ["public"]
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint . --fix",
    "doctor": "react-doctor --yes --no-telemetry",
    "verify": "bun run format && bun run lint && bun run typecheck && bun run doctor && bun run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen:api": "openapi-ts",
    "gen:i18n": "i18next-cli extract && i18next-cli types",
    "gen:i18n:watch": "i18next-cli extract --watch & i18next-cli types --watch & wait",
    "i18n:status": "i18next-cli status",
    "i18n:sync": "i18next-cli sync",
    "i18n:lint": "i18next-cli lint",
    "msw:init": "msw init ./public --save",
    "ui:add": "bunx --bun shadcn@latest add",
    "init": "bun scripts/init.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.5.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "eslint-plugin-storybook": "10.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.9.0",
    "i18next-cli": "1.67.9",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-doctor": "0.9.11",
    "storybook": "10.5.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
