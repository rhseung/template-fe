{
  "name": "template-fe",
  "private": true,
  "type": "module",
  "description": "Frontend paradigm templates — CSR / SSR / SSG. Not a workspace: each templates/* is a standalone project.",
  "scripts": {
    "sync": "bun scripts/sync.ts",
    "check": "bun scripts/sync.ts --check",
    "format": "cd templates/csr && bunx --bun prettier --write --config prettier.config.js --ignore-path .prettierignore ../../shared ../../scripts ../../README.md"
  }
}
